# Brand is configurable. Do not hard-code it in source.
PUBLIC_SITE_NAME=Nepali Knowledge Platform
PUBLIC_SITE_URL=http://localhost:5173

NODE_ENV=development
API_PORT=4000
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://nkp:nkp_dev_password@localhost:5432/nkp
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-value-at-least-32-chars

# Google OAuth web client. Add the exact callback URI to its authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Required when Google sign-in is enabled; only this verified email can receive the first admin role.
BOOTSTRAP_ADMIN_EMAIL=

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-internal-service-token

# Cloudflare R2 (Phase 4)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
